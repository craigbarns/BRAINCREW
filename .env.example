NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Demo mode works without external services.
AUTH_BYPASS=true
AUTH_BYPASS_USER_ID=00000000-0000-4000-8000-000000000001
AUTH_BYPASS_ORGANIZATION_ID=00000000-0000-4000-8000-000000000010

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=postgresql://braincrew_app:change-me@localhost:5432/braincrew
DIRECT_URL=postgresql://postgres:change-me@localhost:5432/braincrew
# Privileged connection used only by verified Stripe webhooks.
WEBHOOK_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/braincrew
REDIS_URL=redis://localhost:6379

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/settings?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/settings?billing=cancelled
DEEPSEEK_API_KEY=
DSH_EXECUTION_MODE=mock
ENCRYPTION_MASTER_KEY=
