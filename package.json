{
  "name": "braincrew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && eslint .railway/railway.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.railway.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @braincrew/database db:generate",
    "db:migrate": "pnpm --filter @braincrew/database db:migrate",
    "db:deploy": "pnpm --filter @braincrew/database db:deploy",
    "db:seed": "pnpm --filter @braincrew/database db:seed",
    "dev:web": "pnpm --filter @braincrew/web dev",
    "dev:api": "pnpm --filter @braincrew/api dev",
    "dev:worker": "pnpm --filter @braincrew/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "railway": "3.11.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@deepseek-ai/dsh-subprocess-local",
      "esbuild",
      "koffi",
      "msgpackr-extract",
      "node-pty",
      "protobufjs",
      "prisma",
      "sharp"
    ]
  }
}
